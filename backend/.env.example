# ── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ── Database (docker-compose provides this locally) ─────
DATABASE_URL="postgresql://vasthu:vasthu_dev_pw@localhost:5432/vasthuconnect?schema=public"

# ── Auth ─────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Field-level encryption key for sensitive data (32-byte hex, e.g. `openssl rand -hex 32`)
FIELD_ENCRYPTION_KEY=replace_with_32_byte_hex_key

# ── SMS provider (OTP delivery) ─────────────────────────
# Leave SMS_PROVIDER=console for local dev — OTPs are logged to the server console instead of sent.
# Swap to "twilio" or "msg91" and fill in credentials to go live.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Email provider (registration OTP delivery) ──────────
# Leave EMAIL_PROVIDER=console for local dev — OTPs are logged to the server console instead of sent.
# "smtp" works with Gmail App Passwords, SendGrid, Mailgun, etc — but note
# some hosts (Render included) block or silently drop outbound SMTP
# connections, which can hang for ~2 minutes before failing instead of
# erroring immediately. If that happens, switch to "sendgrid" (Single Sender
# Verification — just a confirmation click on the from-address mailbox, no
# DNS changes) or "resend" (needs full domain DNS verification, but a nicer
# API) — both send over regular HTTPS, so neither hits that restriction.
EMAIL_PROVIDER=console
EMAIL_FROM="VeeraaLaxme Vastu <noreply@veeralaxmevastu.com>"
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=noreply@veeralaxmevastu.com
SMTP_PASS=
SENDGRID_API_KEY=
RESEND_API_KEY=

# Where Contact page submissions get delivered — leave blank to default to
# SMTP_USER above, or point it at a dedicated inbox (e.g. support@yourdomain.com).
CONTACT_EMAIL=

# ── File storage ─────────────────────────────────────────
# STORAGE_PROVIDER=local stores uploads on disk under /uploads (fine for dev,
# but does NOT survive most production hosts' ephemeral filesystems).
# Swap to "cloudinary" (recommended — free tier, image/video CDN) or "s3" for production.
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── AI (server-side only — never exposed to the frontend) ─
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-haiku-4-5

# ── Maps (used by the frontend but issued/proxied via backend if you want key rotation) ─
GOOGLE_MAPS_API_KEY=

# ── Payments (Razorpay test mode keys — see https://dashboard.razorpay.com) ─
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Rate limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_AUTH=10
RATE_LIMIT_MAX_AI=20
RATE_LIMIT_MAX_GENERAL=300
